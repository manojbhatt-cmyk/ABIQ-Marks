# Store text with LF line endings so scripts work inside Linux containers,
# whatever OS the file was edited on.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never touch
*.xlsx binary
*.pptx binary
*.docx binary
*.pdf binary
*.png binary
*.jpg binary
*.parquet binary
