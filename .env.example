# Copy to .env and fill in your own values. Never commit .env.

# --- App database (Postgres 16 with pgvector, from infra/docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://tiq:tiq@localhost:5432/tiq
TEST_DATABASE_URL=postgresql+psycopg://tiq:tiq@localhost:5432/tiq_test
SECRET_KEY=change-me

# --- Simulated document stores (Box, SharePoint, OneDrive, uploads) and mailbox ---
OBJECT_STORE_ROOT=local-data/objects

# --- Models (OpenAI). Empty key: agents run their deterministic engines only ---
OPENAI_API_KEY=
MODEL_HEAVY=gpt-4o-mini        # spreading, CMR drafting, challenge
MODEL_LIGHT=gpt-4o-mini        # classification, extraction, summaries
EMBEDDING_MODEL=text-embedding-3-small

# --- Tracing: off for now; LangSmith or Langfuse can be switched on later ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tiq-marks-dev

# --- Warehouse: snowflake or duckdb ---
WAREHOUSE=duckdb
WAREHOUSE_DUCKDB_PATH=local-data/warehouse.duckdb
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=            # or key-pair auth below
SNOWFLAKE_PRIVATE_KEY_PATH=    # keep the key file outside the repo
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=TIQ_XS
SNOWFLAKE_DATABASE=TIQ_POC

# --- Write-back adapter: synthetic_write (POC) or queue (production default) ---
WRITEBACK_MODE=synthetic_write
